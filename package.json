{
  "name": "homework-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai-looped": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "lucide": "1.64.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
